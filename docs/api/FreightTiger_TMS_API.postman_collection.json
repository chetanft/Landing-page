{
  "info": {
    "_postman_id": "freighttiger-tms-api-collection",
    "name": "FreightTiger TMS API",
    "description": "Complete API collection for FreightTiger TMS Summary Dashboard.\n\nUpdated: February 2026\n\n## Authentication Flow\n1. Login with encrypted password\n2. Get available desks\n3. Get desk token for operations\n4. Use desk token for orders/indents, login token for other operations\n\n## Password Encryption\nPassword is AES encrypted using SHA256(username + dynamicId) as the key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate dynamic_id if not set",
                  "let dynamicId = pm.environment.get('dynamic_id');",
                  "if (!dynamicId || dynamicId === '') {",
                  "    const timestamp = Date.now();",
                  "    const uuid = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {",
                  "        const r = Math.random() * 16 | 0;",
                  "        const v = c === 'x' ? r : (r & 0x3 | 0x8);",
                  "        return v.toString(16);",
                  "    });",
                  "    dynamicId = timestamp + uuid;",
                  "    pm.environment.set('dynamic_id', dynamicId);",
                  "    console.log('Generated dynamic_id:', dynamicId);",
                  "}",
                  "",
                  "// Try to encrypt password if plain_password is set",
                  "const plainPassword = pm.environment.get('plain_password');",
                  "const username = pm.environment.get('username');",
                  "",
                  "if (plainPassword && username && dynamicId) {",
                  "    try {",
                  "        const CryptoJS = require('crypto-js');",
                  "        const key = CryptoJS.SHA256(username + dynamicId).toString(CryptoJS.enc.Hex);",
                  "        const encryptedPassword = CryptoJS.AES.encrypt(plainPassword, key).toString();",
                  "        pm.environment.set('password', encryptedPassword);",
                  "        console.log('Password encrypted successfully');",
                  "    } catch (e) {",
                  "        console.log('CryptoJS not available - use password-encryptor.html tool');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    const authToken = jsonData.auth_token || jsonData.data?.auth_token;",
                  "    const accessToken = jsonData.access_token || jsonData.accessToken || authToken;",
                  "    const refreshToken = jsonData.refresh_token || jsonData.refreshToken || jsonData.data?.refresh_token;",
                  "    ",
                  "    if (accessToken) {",
                  "        pm.environment.set('access_token', accessToken);",
                  "        console.log('Access token saved');",
                  "        ",
                  "        if (refreshToken) {",
                  "            pm.environment.set('refresh_token', refreshToken);",
                  "            console.log('Refresh token saved');",
                  "        }",
                  "        ",
                  "        // Extract user context from JWT",
                  "        try {",
                  "            const tokenParts = accessToken.split('.');",
                  "            if (tokenParts.length === 3) {",
                  "                const payload = tokenParts[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "                const decoded = JSON.parse(atob(payload));",
                  "                const ucv = decoded?.ucv || {};",
                  "                ",
                  "                if (ucv.id) pm.environment.set('user_fteid', String(ucv.id));",
                  "                if (ucv.companyId) {",
                  "                    pm.environment.set('org_id', String(ucv.companyId));",
                  "                    pm.environment.set('company_fteid', String(ucv.companyId));",
                  "                }",
                  "                if (ucv.groupId) pm.environment.set('branch_fteid', String(ucv.groupId));",
                  "                console.log('User context extracted from token');",
                  "            }",
                  "        } catch (e) {",
                  "            console.log('Could not decode JWT');",
                  "        }",
                  "        ",
                  "        pm.test('Login successful', function () {",
                  "            pm.expect(accessToken).to.not.be.empty;",
                  "        });",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-ft-unique-id", "value": "{{dynamic_id}}" },
              { "key": "Origin", "value": "https://www.freighttiger.com" },
              { "key": "Referer", "value": "https://www.freighttiger.com/" },
              { "key": "Cache-Control", "value": "no-cache" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"grant_type\": \"password\",\n  \"app_id\": \"{{app_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/authentication/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "authentication", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    const accessToken = jsonData.accessToken || jsonData.auth_token;",
                  "    const refreshToken = jsonData.refreshToken || jsonData.refresh_token;",
                  "    if (accessToken) pm.environment.set('access_token', accessToken);",
                  "    if (refreshToken) pm.environment.set('refresh_token', refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "token", "value": "{{access_token}}" },
              { "key": "x-ft-userid", "value": "{{user_fteid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\",\n  \"app_id\": \"web\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/authentication/v1/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "authentication", "v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Get Desks",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    const desks = jsonData.data || [];",
                  "    if (desks.length > 0) {",
                  "        pm.environment.set('desk_fteid', desks[0].fteid || desks[0].id);",
                  "        console.log('First desk FTEID saved:', desks[0].fteid);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Accept", "value": "application/json" },
              { "key": "source", "value": "platform" }
            ],
            "url": {
              "raw": "{{base_url}}/api/entity-service/v1/desk",
              "host": ["{{base_url}}"],
              "path": ["api", "entity-service", "v1", "desk"]
            }
          }
        },
        {
          "name": "Get Desk Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    const deskToken = jsonData.auth_token || jsonData.data?.auth_token;",
                  "    const deskRefresh = jsonData.refresh_token || jsonData.data?.refresh_token;",
                  "    if (deskToken) {",
                  "        pm.environment.set('desk_token', deskToken);",
                  "        console.log('Desk token saved');",
                  "    }",
                  "    if (deskRefresh) {",
                  "        pm.environment.set('desk_refresh_token', deskRefresh);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "token", "value": "{{access_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/authentication/v1/auth/token/desk/{{desk_fteid}}",
              "host": ["{{base_url}}"],
              "path": ["api", "authentication", "v1", "auth", "token", "desk", "{{desk_fteid}}"]
            }
          }
        },
        {
          "name": "Refresh Desk Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "token", "value": "{{desk_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{desk_refresh_token}}\",\n  \"app_id\": \"web\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/authentication/v1/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "authentication", "v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Validate Token",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/authentication/v1/auth/login/validate",
              "host": ["{{base_url}}"],
              "path": ["api", "authentication", "v1", "auth", "login", "validate"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/authentication/v1/auth/login/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "authentication", "v1", "auth", "login", "logout"]
            }
          }
        }
      ]
    },
