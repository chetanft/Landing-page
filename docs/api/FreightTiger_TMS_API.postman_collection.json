        {
          "name": "Orders Master Search",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{desk_token}}", "description": "Prefers desk token" },
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"page\": 1,\n  \"size\": 20,\n  \"group_fteid\": null,\n  \"branch_fteid\": \"{{branch_fteid}}\",\n  \"sort\": [\"-updatedAt\"],\n  \"filters\": [\n    {\n      \"field\": \"STATUS\",\n      \"operator\": \"in\",\n      \"value\": [\"UNPLANNED\", \"PARTIALLY_PLANNED\", \"PLANNED\", \"DISPATCHED\"]\n    },\n    {\n      \"field\": \"CREATED_AT\",\n      \"operator\": \">=\",\n      \"value\": {{from_timestamp}}\n    },\n    {\n      \"field\": \"CREATED_AT\",\n      \"operator\": \"<=\",\n      \"value\": {{to_timestamp}}\n    }\n  ],\n  \"includeDeletedOnly\": false\n}"
            },
            "url": {
              "raw": "{{planning_base_url}}/orders/master-search",
              "host": ["{{planning_base_url}}"],
              "path": ["orders", "master-search"]
            }
          }
        },
